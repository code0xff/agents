# No backend: all data is fetched in the browser from public RPCs / public APIs.
# Values are inlined into the bundle at build time, so only use keys that are safe to publish (domain-restricted).
VITE_BASE=/agents/
VITE_RPC_BASE=https://mainnet.base.org
VITE_RPC_BNB=https://bsc-rpc.publicnode.com
VITE_RPC_POLYGON=https://polygon-bor-rpc.publicnode.com
VITE_RPC_SOLANA=https://solana-rpc.publicnode.com
